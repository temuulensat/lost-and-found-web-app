# Python bytecode, caches, test output, and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp

# Local environment variables, credentials, and private keys
.env
.env.*
*.env
*.env.local
*.env.production
*.env.development
*.env.test
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
