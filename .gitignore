*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.sqlite3-*
*.db-*

# User reports, uploaded photos, and backups
instance/*
!instance/.gitkeep
app/static/uploads/*
!app/static/uploads/.gitkeep
uploads/
backups/
*.tar.gz

